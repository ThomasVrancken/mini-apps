# Local development. Copy to .env (gitignored) and fill in.
# Firestore uses Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=PROJECT_ID

# ALWAYS a dev prefix locally: the Firestore database is the real one.
COLLECTION_PREFIX=SERVICE_NAMEdev_

# Access code / bearer token. Generate with: openssl rand -hex 32
APP_TOKEN=

# LLM (pick one provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_MODEL_FAST=gpt-5.4-mini
# VERTEX_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash

# Set to false to skip the background "learned" reflection (no LLM spend
# while running the API smoke test).
REFLECTION_ENABLED=true

PORT=3002
