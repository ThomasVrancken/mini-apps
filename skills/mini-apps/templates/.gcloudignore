# Files NOT uploaded by `gcloud app deploy`. App Engine runs the root `build`
# script, which installs and builds the client in Cloud Build, so client
# source IS uploaded but local dependencies and build output are not.
.gcloudignore
.git
.gitignore
.env
.env.*
.DS_Store
.venv/
node_modules/
client/node_modules/
client/dist/
scripts/
backups/
*.log
