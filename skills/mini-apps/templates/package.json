{
  "name": "SERVICE_NAME",
  "version": "0.1.0",
  "private": true,
  "description": "APP_NAME: personal mini app (Express API + React PWA) on App Engine Standard",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "deploy": "gcloud app deploy app.yaml --project PROJECT_ID --quiet",
    "test:api": "node scripts/api-test.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "openai": "^7.15.0"
  }
}
